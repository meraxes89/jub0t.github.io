---
// The landing page in its default language, at the bare `/`: the address a
// shared link or a search result carries, and the one the first-visit
// script redirects from a browser it can do better by.
import Layout from '../layouts/Layout.astro';
import Landing from '../components/Landing.astro';
import { defaultLocale } from '../i18n/config';
import { dictFor } from '../i18n';
import { getPageData } from '../lib/github';

const { repo, release, stars } = await getPageData();
---

<Layout stars={stars} locale={defaultLocale}>
	<Landing ui={dictFor(defaultLocale.code)} repo={repo} release={release} />
</Layout>
